{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist/**", "build/**", "node_modules/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }]
  }
}
