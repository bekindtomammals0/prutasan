{
  "name": "prutasan",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "test:e2e": "npm run test:e2e --workspace backend",
    "test": "npm run test:unit",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bekindtomammals0/prutasan.git"
  },
  "keywords": [],
