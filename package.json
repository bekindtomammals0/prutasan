  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bekindtomammals0/prutasan/issues"
  },
  "homepage": "https://github.com/bekindtomammals0/prutasan#readme",
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
