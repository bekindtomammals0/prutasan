{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "watchman": false,
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testMatch": ["<rootDir>/test/e2e/**/*.e2e-spec.ts"],
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ESNext"
        }
      }
    ]
  }
}
